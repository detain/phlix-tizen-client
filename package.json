{
  "name": "phlix-tizen",
  "version": "1.0.0",
  "description": "Samsung Tizen TV client for Phlix Media Server",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version:sync": "node scripts/version-sync.mjs",
    "package": "node scripts/version-sync.mjs && npm run build && node scripts/package.js"
  },
  "keywords": [
    "phlix",
    "samsung",
    "tizen",
    "smarttv",
    "media-server"
  ],
  "author": "Phlix",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/detain/phlix-tizen-client"
  },
  "homepage": "https://github.com/detain/phlix-tizen-client",
  "dependencies": {
    "@phlix/contracts": "github:detain/phlix-contracts#v0.5.3",
    "@phlix/syncplay": "github:detain/phlix-syncplay#v0.1.5",
    "@phlix/ui": "github:detain/phlix-ui#v0.99.10",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "rimraf": "^6.1.3",
    "@vue/server-renderer": "^3.5.42"
  }
}
