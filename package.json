{
  "name": "phlix-tizen",
  "version": "1.0.0",
  "description": "Samsung Tizen TV client for Phlix Media Server",
  "main": "src/main.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "npm run build && node scripts/package.js"
  },
  "keywords": [
    "phlix",
    "samsung",
    "tizen",
    "smarttv",
    "media-server"
  ],
  "author": "Phlix",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/detain/phlix-tizen-client"
  },
  "homepage": "https://github.com/detain/phlix-tizen-client",
  "dependencies": {
    "@phlix/contracts": "github:detain/phlix-contracts#v0.3.11",
    "@phlix/syncplay": "github:detain/phlix-syncplay#v0.1.2",
    "@phlix/ui": "https://github.com/detain/phlix-ui/archive/refs/tags/v0.79.0.tar.gz",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.20.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "@vue/test-utils": "^2.4.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob": "^13.0.6",
    "rimraf": "^6.1.3"
  }
}
